{
  "schemaVersion": 1,
  "id": "cobblekanto_server_fixes",
  "version": "${version}",
  "name": "CobbleKanto Server Fixes",
  "description": "CobbleKanto server-side hotfixes plus isolated client compatibility fixes.",
  "authors": [
    "CobbleKanto Team"
  ],
  "license": "CobbleKanto Project Custom License",
  "environment": "*",
  "entrypoints": {
    "client": [
      "net.crulim.cobblekantoserverfixes.CobbleKantoServerFixesClient"
    ],
    "server": [
      "net.crulim.cobblekantoserverfixes.CobbleKantoServerFixesDedicatedServer"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "cobblekanto": "*",
    "daycareplus": "*",
    "exposure": "*",
    "cobblemonraiddens": "=0.11.1+1.21.1",
    "eclipsescustomname": "=0.3.3-1.21.1"
  },
  "mixins": [
    {
      "config": "cobblekanto_server_fixes.mixins.json",
      "environment": "server"
    }
  ]
}
